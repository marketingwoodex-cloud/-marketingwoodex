# Woodex Interior Design Studio — Hostinger Master .htaccess
# Optimized for Hostinger LiteSpeed / Apache 2.4+
DirectoryIndex index.php index.html

<IfModule mod_setenvif.c>
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

Options -Indexes
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html
ErrorDocument 503 /503.html

# Force HTTPS & Strip WWW
<IfModule mod_rewrite.c>
RewriteEngine On

# Pass Authorization header to PHP (MCP / Admin API)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Force HTTPS + non-www canonical
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block private directories and dotfiles
RewriteRule ^_private(/|$) - [F,L]
RewriteRule (^|/)\.(?!well-known) - [F,L]
</IfModule>

# Block sensitive library files, logs, and database backups from direct URL hits
<FilesMatch "(-lib\.php|^error_log|\.log|\.sql|\.bak|\.env|\.env\.example)$">
Require all denied
</FilesMatch>

# Security Headers & Browser Caching
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=()"

<FilesMatch "\.(css|js|webp|jpg|jpeg|png|gif|svg|woff2|woff|ttf|ico)$">
Header set Cache-Control "public, max-age=2592000, immutable"
</FilesMatch>
</IfModule>

# GZIP & Deflate Compression
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml
</IfModule>
