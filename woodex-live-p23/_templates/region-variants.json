  "note": "Timber / finish variant matrix used by the regional estimator. Species and coating keys are the same tokens used by the workshop cutting lists and the quotation line catalogue in /assets/js/estimator-rates.js. Board-foot rates are Lahore baselines (index 1.00); every other node multiplies by its node index from _templates/region-nodes.json.",
  "formulas": {
    "board_feet_metric": "(t_mm / 25.4) * (w_mm / 25.4) * (len_mm / 304.8) / 12",
    "board_feet_imperial": "(t_in * w_in * len_ft) / 12",
    "net_bf": "sum(panel BF) * qty",
    "waste_bf": "net_bf * waste_pct / 100  (waste_pct from the node rate card)",
    "gross_bf": "net_bf + waste_bf",
    "material_cost": "gross_bf * species.rate_bf * node_index",
    "coating_cost": "surface_sqft * coating.rate_sqft * faces_factor * node_index",
    "labour_cost": "(material_cost + coating_cost) * node.labour_pct / 100",
    "line_total": "material_cost + coating_cost + labour_cost + hardware + transport",
    "quote_total": "sum(line_total) + GST(tax_pct) - discount",
    "surface_sqft": "(2 * (w_mm * len_mm) / 92903.04) * faces"
  },
