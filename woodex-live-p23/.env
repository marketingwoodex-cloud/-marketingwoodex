# =============================================================================
# Woodex Interior Design Studio — environment reference
# Domain: woodex.com.pk · Hostinger cPanel / LiteSpeed
# -----------------------------------------------------------------------------
# READ THIS FIRST
#   * Nothing in this codebase reads .env at runtime. The admin keeps its live
#     database login in _private/db.json, which is blocked from the web by
#     _private/.htaccess and is not committed. This file is a reference sheet so
#     a new server can be configured in the right order.
#   * Never commit real passwords, API keys or bot tokens here. Set them in
#     _private/db.json (database) and in Admin → Integrations (Telegram,
#     WhatsApp, Google, SMTP). The previous revision of this file carried a live
#     database password and Telegram bot token — both are now placeholders and
#     both must be rotated.
# =============================================================================

# --- Application ---
APP_NAME="Woodex Interior Design Studio"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://woodex.com.pk
ADMIN_EMAIL=admin@woodex.pk

# --- Hostinger MySQL (fill in on the server; the admin writes _private/db.json) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u128159657_woodex
DB_USERNAME=u128159657_woodex
DB_PASSWORD=CHANGE_ME_SET_IN_PRIVATE_DB_JSON

# --- Contact & notifications ---
MAIL_FROM_ADDRESS=info@woodex.com.pk
MAIL_FROM_NAME="Woodex Interior Design Studio"
WHATSAPP_NUMBER=+923001234567

# --- Telegram (@WoodexInteriorBot) — paste a NEW token from BotFather here is NOT needed; use Admin → Integrations ---
TELEGRAM_BOT_USERNAME=@WoodexInteriorBot
TELEGRAM_BOT_TOKEN=CHANGE_ME_ROTATE_IN_BOTFATHER
