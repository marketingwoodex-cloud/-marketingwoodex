--- a/assets/uploads/.htaccess	2026-10-09 16:20:58.000000000 +0000
+++ b/assets/uploads/.htaccess	2026-10-09 16:39:02.685834138 +0000
@@ -1,4 +1,38 @@
+# ============================================================================
+#  Woodex uploads folder — stored media only. Nothing here may ever execute.
+#
+#  Hostinger runs PHP through PHP-FPM / LiteSpeed. A bare `php_flag` in
+#  .htaccess makes those servers answer every request in this folder with
+#  "500 Internal Server Error", so the directive is wrapped in <IfModule>
+#  and only applies when PHP really runs as an Apache module.
+# ============================================================================
+
+Options -Indexes -ExecCGI
+
+<IfModule mod_php.c>
 php_flag engine off
-<FilesMatch "\.(php|phtml|phar|html?|js|svg)$">
+</IfModule>
+<IfModule mod_php7.c>
+php_flag engine off
+</IfModule>
+
+RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh
+RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
+
+# Scripts must never run, even if one gets uploaded
+<FilesMatch "\.(php|phtml|php[0-9]|phar|pl|py|cgi|sh|asp|aspx|jsp)$">
+Require all denied
+</FilesMatch>
+
+# Stored-XSS guard: uploaded HTML / SVG / JS is never rendered back
+<FilesMatch "\.(html?|svg|js|mjs|xml|htc)$">
 Require all denied
 </FilesMatch>
+
+# Apache 2.2 fallback (mod_authz_core missing)
+<IfModule !mod_authz_core.c>
+<FilesMatch "\.(php|phtml|php[0-9]|phar|pl|py|cgi|sh|html?|svg|js|mjs|xml|htc)$">
+Order allow,deny
+Deny from all
+</FilesMatch>
+</IfModule>
