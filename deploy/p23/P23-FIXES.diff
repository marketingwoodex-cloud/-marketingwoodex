+# Compatibility folder for the Hostinger upload checklist.
+# Woodex stores every uploaded file in /assets/uploads/ (api/builder.php,
+# api/media-lib.php and api/chat-lib.php all write there), so this folder only
+# forwards requests to it — nothing is stored here and nothing may execute.
+Options -Indexes -ExecCGI
+
+<IfModule mod_rewrite.c>
+RewriteEngine On
+RewriteRule ^(.*)$ /assets/uploads/$1 [L]
+</IfModule>
+
+<FilesMatch "\.(php|phtml|php[0-9]|phar|pl|py|cgi|sh)$">
+Require all denied
+</FilesMatch>
